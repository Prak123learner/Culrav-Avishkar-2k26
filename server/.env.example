NODE_ENV=development
PORT=3000
MONGO=mongodb://127.0.0.1:27017/culrav_avishkar
MONGO_MAX_POOL_SIZE=10
# Registration writes require a replica set. After configuring local rs0, use:
# MONGO=mongodb://127.0.0.1:27017/culrav_avishkar?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES=8h
FRONTEND_URL=http://localhost:5173
# Production: exact frontend origin allowed by credentialed CORS, for example:
# FRONTEND_URL=https://www.example.edu
BACKEND_URL=http://localhost:3000
# Production: public backend origin, for example https://your-api.vercel.app.
# It is operational documentation and is not exposed to the frontend.
# Prefer https://api.example.edu for the backend so browser sessions stay same-site.
COOKIE_SAME_SITE=lax
# Use COOKIE_SAME_SITE=none only for an HTTPS frontend/API on unrelated sites.
# Some browsers block third-party cookies, so this is a fallback, not the preferred setup.
ADMIN_EMAIL=admin@example.com

# Enable Google in Firebase Authentication. Never expose these private fields to Vite.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"
# Alternatively use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.

# Optional for coordinator credential delivery. Without SMTP the admin sees the temporary password once.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
